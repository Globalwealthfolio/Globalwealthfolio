---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Blog — Global Wealth Portfolio | Investment, Expense, and Goal Tracking Guides"
  description="Read expert guides on portfolio management, expense tracking, goal planning, and achieving financial freedom. Practical advice for global investors."
>
  <section class="container-page page-section pt-3xl pb-2xl">
    <p class="text-caption-mono text-gold mb-xs">Blog</p>
    <h1 class="text-display-lg mb-md">Guides &amp; articles for smarter financial tracking.</h1>
    <p class="text-body-lg text-body max-w-2xl mb-4xl leading-relaxed">
      Practical advice on portfolio management, expense tracking, goal planning,
      and building lasting financial freedom — written for global investors.
    </p>

    <!-- Topic hub filter -->
    <div id="topic-filter-bar" class="flex flex-wrap gap-sm mb-lg" style="display:none;"></div>

    <div id="admin-blog-list" class="grid grid-cols-1 md:grid-cols-2 gap-md mb-2xl">
      <div class="md:col-span-2 text-center py-5xl card-soft">
        <p class="text-body-md text-body">Loading…</p>
      </div>
    </div>

    <!-- Newsletter subscription -->
    <div class="card-soft p-xl mb-4xl">
      <p class="text-caption-mono text-gold mb-xs">Newsletter</p>
      <h2 class="text-display-md mb-sm">Stay updated</h2>
      <p class="text-body-md text-body mb-md max-w-lg">
        Get notified when new articles are published — no spam, unsubscribe anytime.
      </p>
      <form id="subscribe-form" class="flex flex-col sm:flex-row gap-sm max-w-md">
        <input
          type="email"
          id="subscribe-email"
          placeholder="your@email.com"
          required
          class="input flex-1"
        />
        <button type="submit" class="btn-primary">Subscribe</button>
      </form>
      <p id="subscribe-msg" class="text-body-sm mt-sm" style="display:none;"></p>
    </div>

    <hr class="border-hairline my-4xl" />

    <!-- About Me -->
    <div class="mb-4xl">
      <p class="text-caption-mono text-gold mb-xs">About Me</p>
      <h2 class="text-display-md mb-lg">Hello, I&rsquo;m Sourabhsingh Rajput</h2>
      <div class="text-body-md text-body leading-relaxed space-y-md max-w-3xl">
        <p>
          A mechanical engineering professional with over a decade of experience
          in core product design. My career has been built on solving complex
          engineering challenges, creating innovative solutions, and contributing
          to product development across industries.
        </p>
        <p>
          Alongside my engineering journey, I&rsquo;ve nurtured a strong passion
          for the financial markets. For more than 11 years, I&rsquo;ve actively
          traded, studied, and refined investment strategies &mdash; turning what
          began as a hobby into a parallel expertise. Over time, I started
          managing investment portfolios for my family members, building
          customized strategies and dashboards to track performance, risk, and
          goals.
        </p>
        <p>
          Initially, this meant countless hours of maintaining Excel spreadsheets
          and financial dashboards. But now, with this website, I&rsquo;ve
          streamlined the process &mdash; reducing manual work and creating a
          more efficient, transparent, and scalable way to manage portfolios.
        </p>
        <p>
          This tool has been built in collaboration with Financial Advisors,
          CFAs, Chartered Accountants, and a consulting cyber security expert
          for encryption &amp; privacy, ensuring that the framework aligns with
          professional standards of wealth management. It is already being used
          by some Portfolio Management Service (PMS) owners to manage their
          clients&rsquo; investments more effectively.
        </p>
        <p>
          This platform reflects both sides of my professional life:
        </p>
        <ul class="list-disc pl-lg space-y-xs">
          <li>The precision and problem-solving mindset of an engineer.</li>
          <li>The analytical and strategic thinking of a financial market practitioner.</li>
        </ul>
        <p>
          My goal is simple: to make portfolio management smarter, easier, and
          more accessible &mdash; for myself and anyone passionate about building
          wealth with clarity like yourself.
        </p>
        <p class="text-body-md text-ink font-medium pt-sm">
          Happy to connect with like&ndash;minded people who share an interest in
          engineering, investing, or building smarter financial tools.
        </p>
      </div>
    </div>
  </section>
</Layout>

<script>
  function esc(s) {
    return s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;").replace(/'/g, "&#39;");
  }

  function formatDate(iso) {
    try {
      return new Date(iso).toLocaleDateString(undefined, { year: "numeric", month: "short", day: "numeric" });
    } catch { return iso; }
  }

  function isNew(iso) {
    try {
      const then = new Date(iso);
      const now = new Date();
      const msPerWeek = 7 * 24 * 60 * 60 * 1000;
      return (now - then) < msPerWeek;
    } catch { return false; }
  }

  let allPosts = [];
  let activeTopicHub = null;
  let hubNames = {};

  function renderPosts() {
    const list = document.getElementById("admin-blog-list");
    if (!list) return;

    const filtered = activeTopicHub
      ? allPosts.filter(p => p.topicHub === activeTopicHub)
      : allPosts;

    if (filtered.length === 0) {
      list.innerHTML = `<div class="md:col-span-2 text-center py-5xl card-soft"><p class="text-body-sm text-body">${activeTopicHub ? 'No posts in this topic yet.' : 'No posts yet. Check back soon!'}</p></div>`;
      return;
    }

    list.innerHTML = filtered
      .map(
        (p) => `
      <article class="card hover:shadow-level-3 transition-shadow flex flex-col gap-sm">
        <div class="flex items-center justify-between">
          <span class="text-caption text-mute">${formatDate(p.publishedAt ?? p.updatedAt)}</span>
        </div>
        <h3 class="text-display-sm text-ink">${esc(p.title)}${isNew(p.publishedAt ?? p.updatedAt) ? '<sup class="text-caption-mono text-gain font-medium" style="font-size:0.6em;top:-0.5em;margin-left:4px;">New</sup>' : ""}</h3>
        ${
          p.topicHub && hubNames[p.topicHub]
            ? `<div class="flex flex-wrap gap-xs mt-xs"><a href="/blog/topics?hub=${encodeURIComponent(p.topicHub)}" class="badge badge-brand hover:opacity-80 no-underline">${esc(hubNames[p.topicHub])}</a></div>`
            : ""
        }
        ${
          p.excerpt
            ? `<p class="text-body-md text-body line-clamp-2">${esc(p.excerpt)}</p>`
            : `<p class="text-body-md text-body line-clamp-2">${esc(p.content.slice(0, 140))}${p.content.length > 140 ? "…" : ""}</p>`
        }
        ${
          p.tags.length > 0
            ? `<div class="flex flex-wrap gap-xs mt-xs">${p.tags.map((t) => `<span class="badge">${esc(t)}</span>`).join("")}</div>`
            : ""
        }
        <div class="flex items-center justify-between mt-md pt-sm border-t border-hairline">
          <span class="text-caption text-mute">${p.authorName ? `By ${esc(p.authorName)}` : ""}</span>
          <a href="/blog/view?slug=${encodeURIComponent(p.slug)}" class="text-body-sm text-link hover:underline">Read more →</a>
        </div>
      </article>`,
      )
      .join("");
  }

  function renderFilterBar(hubs) {
    const bar = document.getElementById("topic-filter-bar");
    if (!bar || hubs.length === 0) return;

    bar.innerHTML = "";

    const allBtn = document.createElement("button");
    allBtn.className = activeTopicHub ? "badge" : "badge badge-brand";
    allBtn.textContent = "All";
    allBtn.addEventListener("click", () => {
      activeTopicHub = null;
      renderFilterBar(hubs);
      renderPosts();
    });
    bar.appendChild(allBtn);

    hubs.forEach(h => {
      const btn = document.createElement("button");
      const isActive = activeTopicHub === h.slug;
      btn.className = isActive ? "badge badge-brand" : "badge";
      btn.textContent = h.name;
      btn.addEventListener("click", () => {
        activeTopicHub = h.slug;
        renderFilterBar(hubs);
        renderPosts();
      });
      bar.appendChild(btn);
    });

    bar.style.display = "flex";
  }

  async function loadPosts() {
    const list = document.getElementById("admin-blog-list");
    if (!list) return;
    try {
      try {
        const hubsRes = await fetch("/api/topic-hubs");
        const hubsData = await hubsRes.json();
        if (hubsData.topicHubs) {
          hubsData.topicHubs.forEach(h => { hubNames[h.slug] = h.name; });
          renderFilterBar(hubsData.topicHubs);
        }
      } catch (_) {}

      const res = await fetch("/api/blog");
      const data = await res.json();
      allPosts = (data.posts || []).filter((p, i, arr) => arr.findIndex(x => x.id === p.id || x.slug === p.slug) === i)
        .filter((p) => {
          if (p.status === "scheduled" && p.scheduledAt) {
            return new Date(p.scheduledAt) <= new Date();
          }
          return p.status === "published";
        });

      renderPosts();
    } catch {
      list.innerHTML = `<div class="md:col-span-2 text-center py-5xl card-soft"><p class="text-body-sm text-body">Failed to load posts. Try again later.</p></div>`;
    }
  }

  loadPosts();

  // Newsletter subscription
  const subForm = document.getElementById("subscribe-form");
  const subEmail = document.getElementById("subscribe-email");
  const subMsg = document.getElementById("subscribe-msg");
  subForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const email = subEmail.value.trim();
    const btn = subForm.querySelector("button");
    btn.disabled = true;
    btn.textContent = "Subscribing\u2026";
    try {
      const res = await fetch("/api/subscribe", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email }),
      });
      const data = await res.json();
      subMsg.className = "text-body-sm mt-sm " + (res.ok ? "text-gain" : "text-loss");
      subMsg.textContent = data.message || data.error || "Done.";
      subMsg.style.display = "block";
      if (res.ok) subEmail.value = "";
    } catch {
      subMsg.className = "text-body-sm mt-sm text-loss";
      subMsg.textContent = "Network error. Try again.";
      subMsg.style.display = "block";
    }
    btn.disabled = false;
    btn.textContent = "Subscribe";
  });
</script>
